# Copy to .env (gitignored) and fill in locally. GitHub Actions reads the same
# names from repository secrets. Leave LAKE_URI empty to use a local ./lake
# folder; set it to s3://bank-atlas-lake to use the R2 bucket. R2_ACCOUNT_ID is
# the part before .r2.cloudflarestorage.com in the bucket's S3 address; the two
# keys come from an R2 API token limited to that bucket (Object Read & Write).
LAKE_URI=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
